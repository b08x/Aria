# ARIA Docker Environment Configuration
# Copy this file to .env and configure your API keys

# =============================================================================
# NGINX CONFIGURATION
# =============================================================================
NGINX_HOST=localhost

# =============================================================================
# AI PROVIDER API KEYS
# =============================================================================

# Google Gemini API Key
# Get your key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=

# OpenAI API Key  
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic Claude API Key
# Get your key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Mistral AI API Key
# Get your key from: https://console.mistral.ai/
MISTRAL_API_KEY=

# OpenRouter API Key (for multiple model access)
# Get your key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# =============================================================================
# ADDITIONAL SERVICES
# =============================================================================

# Google Custom Search API Key (for research features)
# Get your key from: https://developers.google.com/custom-search/v1/introduction
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# ElevenLabs API Key (for text-to-speech)
# Get your key from: https://elevenlabs.io/
ELEVENLABS_API_KEY=

# =============================================================================
# SSL CONFIGURATION (for production)
# =============================================================================

# Email for Let's Encrypt SSL certificates
LETSENCRYPT_EMAIL=

# =============================================================================
# DEVELOPMENT OPTIONS
# =============================================================================

# Set to 'production' for production builds
NODE_ENV=development

# =============================================================================
# USAGE INSTRUCTIONS
# =============================================================================
#
# 1. Copy this file to .env:
#    cp .env.docker .env
#
# 2. Fill in your API keys above
#
# 3. Start the application:
#    # Development mode
#    docker-compose up -d
#
#    # Production mode  
#    docker-compose -f docker-compose.prod.yml up -d
#
#    # Development with hot reload
#    docker-compose --profile dev up -d
#
# 4. Access the application:
#    http://localhost (or your configured NGINX_HOST)
#
# =============================================================================