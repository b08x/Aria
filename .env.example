# AI Provider API Keys
# Copy this file to .env.local and set your actual API keys
# Leave empty to prompt for them in the UI

# Google Gemini
GEMINI_API_KEY=

# OpenAI
OPENAI_API_KEY=

# Anthropic Claude
ANTHROPIC_API_KEY=

# Mistral
MISTRAL_API_KEY=

# OpenRouter
OPENROUTER_API_KEY=

# Google Custom Search (for research features)
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# ElevenLabs (for text-to-speech)
ELEVENLABS_API_KEY=